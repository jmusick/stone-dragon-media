---
import packageJson from "../../package.json";
import SocialLinks from "./SocialLinks.astro";

const currentYear = new Date().getFullYear();
const siteVersion = packageJson.version;
---

<footer class="site-footer">
	<nav class="footer-nav" aria-label="Footer">
		<ul>
			<li><a href="/services/">Services</a></li>
			<li><a href="/work/">Our Work</a></li>
			<li><a href="/products/">Products</a></li>
			<li><a href="/about/">About</a></li>
			<li><a href="/contact/">Contact</a></li>
			<li><a href="/login/">Client Login</a></li>
		</ul>
	</nav>
	<div class="footer-copy">
		Copyright {currentYear} Stone Dragon Media, LLC. All rights reserved.
		<div class="footer-nap">Sandusky, OH &middot; <a href="tel:+15674500960">(567) 450-0960</a></div>
	</div>
	<SocialLinks class="footer-social" />
	<div class="footer-right">
		<a class="footer-link" href="/privacy-policy/">Privacy Policy</a>
		<a class="footer-link" href="/sitemap/">Sitemap</a>
		<span class="footer-version" aria-label="Site version">v{siteVersion}</span>
	</div>
</footer>