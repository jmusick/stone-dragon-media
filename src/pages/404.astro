---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { serviceCategoryLinks } from "../lib/services";

export const prerender = true;
---

<BaseLayout
  title="404 | Stone Dragon Media"
  description="The page you requested could not be found."
  canonical="https://stonedragonmedia.com/404"
  ogUrl="https://stonedragonmedia.com/404"
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <style>
      .wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 5rem 1.25rem;
        text-align: center;
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--brand-strong);
      }

      p {
        margin: 0.8rem auto 0;
        max-width: 42ch;
        color: var(--ink);
        line-height: 1.6;
      }

      .actions {
        margin-top: 1.3rem;
      }

      .next-steps {
        margin: 2.2rem auto 0;
        padding: 0;
        max-width: 42ch;
        list-style: none;
        text-align: left;
      }

      .next-steps > li {
        padding: 0.85rem 0;
        border-top: 1px solid var(--line);
        line-height: 1.6;
        color: var(--ink);
      }

      .next-steps a {
        font-weight: 700;
        color: var(--brand);
      }

      .next-steps .sub {
        margin: 0.35rem 0 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        color: var(--ink-soft);
      }

      .next-steps .sub a {
        font-weight: 400;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 2rem;
      }

      .site-footer {
        margin-top: 1.6rem;
      }
    </style>
  </Fragment>

  <SiteHeader />

  <main class="wrapper" id="main-content">
    <h1>Page Not Found</h1>
    <p>
      We couldn&rsquo;t find that page. Head back to the homepage to explore our services and work.
    </p>
    <div class="actions">
      <a class="button button-primary" href="/">Go to Homepage</a>
    </div>
    <ul class="next-steps">
      <li>
        <a href="/services/">Services</a>
        <ul class="sub">
          {serviceCategoryLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </li>
      <li><a href="/work/">Our Work</a></li>
      <li>
        <a href="/contact/">Contact</a>, or call or text
        <a href="tel:+15674500960">(567) 450-0960</a>
      </li>
    </ul>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
