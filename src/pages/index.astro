---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { serviceCategories } from "../lib/services";
import { socialProfileUrls } from "../lib/social";
import { inPersonCities, inPersonAreaServed, remoteCoverage, joinList } from "../lib/service-area";
import { featuredWork } from "../lib/work";

export const prerender = true;

---

<BaseLayout
  title="Web Design in Sandusky, Ohio | Stone Dragon Media"
  description="Custom web design, business applications, and digital strategy in Sandusky, Ohio. Serving local businesses and remote clients across the US."
  canonical="https://stonedragonmedia.com/"
  ogUrl="https://stonedragonmedia.com/"
  ogImage="https://stonedragonmedia.com/header-bg.webp"
  ogImageAlt="Stone Dragon Media — custom web design and digital strategy in Sandusky, Ohio"
  includeGenerator={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Stone Dragon Media",
      "url": "https://stonedragonmedia.com",
      "logo": "https://stonedragonmedia.com/logo.png",
      "image": "https://stonedragonmedia.com/logo.png",
      "description": "Stone Dragon Media provides custom web design, business applications, digital marketing, and consulting in Sandusky, Ohio, and for remote clients.",
      "telephone": "+1-567-450-0960",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sandusky",
        "addressRegion": "OH",
        "addressCountry": "US"
      },
      "areaServed": inPersonAreaServed,
      "sameAs": socialProfileUrls
    })} />
    <style>
      /* One card per category: four across on wide screens, 2 x 2 below 1100px, one column on phones. */
      .services {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
      }

      .services .card ul {
        margin: 0.8rem 0 0;
        padding-left: 1.1rem;
        color: var(--ink-soft);
      }

      .services .card li {
        margin: 0 0 0.25rem;
      }

      .services-more {
        max-width: 68ch;
        margin: 1.4rem 0 0;
      }

      .work-shots {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .hero-note {
        flex-basis: 100%;
        margin: 0.5rem 0 0;
        font-size: 0.95rem;
        color: #dfe7ed;
      }

      .hero-note span {
        display: block;
        max-width: 34rem;
      }

      .areas-list {
        columns: 5 11rem;
        column-gap: 2rem;
        margin: 1.6rem 0 1.8rem;
        padding: 1.4rem 0;
        list-style: none;
        border-top: 1px solid rgba(169, 193, 212, 0.25);
        border-bottom: 1px solid rgba(169, 193, 212, 0.25);
      }

      .areas-list li {
        padding: 0.2rem 0;
        font-weight: 600;
        color: #fff;
        break-inside: avoid;
      }

      @media (max-width: 1100px) {
        .services,
        .work-shots {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        .services {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="home" showCta={true} />

  <main id="main-content">
    <PageHero
      tall
      image="/header-bg.webp"
      alt="Stone Dragon Media — custom web design and digital strategy agency based in Sandusky, Ohio"
      title="Sandusky, Ohio web design for your business"
      desc="Make it easy for customers to understand what you offer and get in touch. We build custom websites and business applications, with ongoing support after launch."
      position="center 35%"
    >
      <a class="button button-primary" href="/contact/">
        <Icon class="icon" name="lucide:send" aria-hidden="true" />
        Discuss Your Project
      </a>
      <a class="button button-secondary" href="/services/">View Services</a>
      <p class="hero-note">
        <span>IT and development experience since 1998.</span>
        <span>Free consultations. We reply within one business day.</span>
      </p>
    </PageHero>

    <div class="page">
      <section class="section" id="services">
        <h2 class="section-title">Our Web Design &amp; Digital Services</h2>
        <div class="services">
          {serviceCategories.map((category) => (
            <article class="card">
              <Icon class="icon" name={category.icon} aria-hidden="true" />
              <h3><a href={`/services/${category.slug}/`}>{category.name}</a></h3>
              <p>{category.summary}</p>
              <ul>
                {category.services.map((service) => (
                  <li><a href={`/services/${category.slug}/#${service.id}`}>{service.name}</a></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        <p class="services-more">
          See the full breakdown on our <a href="/services/">services page</a>, browse
          <a href="/work/">recent projects</a> in our portfolio, or read more
          <a href="/about/">about Stone Dragon Media</a> and the
          <a href="/products/">products we build</a>.
        </p>
      </section>

      <section class="section" id="recent-work">
        <h2 class="section-title">Recent Work</h2>
        <div class="work-shots">
          {featuredWork.map(({ slug, thumb, thumbAlt, name, shotDesc }) => (
            <a class="shot" href={`/work/${slug}/`}>
              <img src={thumb} alt={thumbAlt} loading="lazy" width="1180" height="615" />
              <span class="shot-name">{name}</span>
              <span class="shot-desc">{shotDesc}</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <section class="band" id="areas-served">
      <div class="band-inner">
        <h2>Areas We Serve</h2>
        <p>
          Stone Dragon Media is based in Sandusky, Ohio. We work on site with businesses across
          Sandusky, Erie County, and the surrounding communities:
        </p>
        <ul class="areas-list">
          {inPersonCities.map((city) => <li>{city}</li>)}
        </ul>
        <p>
          We also meet clients in person within about an hour&rsquo;s drive &mdash; Toledo to the
          west, Cleveland to the east, and the Lorain and Elyria corridor in between. Farther out,
          including {joinList(remoteCoverage.exampleCities)}, we work remotely, as we do with
          {remoteCoverage.scope}.
        </p>
      </div>
    </section>
    <div class="page">
      <section class="section">
        <h2 class="section-title">Tell us about your project</h2>
        <p>Tell us about your website, application, or the problem you need help solving. We&rsquo;ll follow up within one business day. Consultations are free.</p>
        <a class="button button-primary" href="/contact/">Discuss Your Project</a>
      </section>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
