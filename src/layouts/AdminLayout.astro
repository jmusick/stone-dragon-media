---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
}

const { title } = Astro.props;

const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, "");
const isActive = (prefix: string) => currentPath === prefix || currentPath.startsWith(`${prefix}/`);

const navItems = [
  { href: "/admin", label: "Overview", icon: "lucide:layout-dashboard", exact: true },
  { href: "/admin/clients", label: "Clients", icon: "lucide:users", exact: false },
  { href: "/admin/projects", label: "Projects", icon: "lucide:folder-kanban", exact: false },
  { href: "/admin/billing", label: "Billing", icon: "lucide:credit-card", exact: false },
  { href: "/admin/tickets", label: "Tickets", icon: "lucide:life-buoy", exact: false },
  { href: "/admin/settings", label: "Settings", icon: "lucide:settings", exact: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | {title} | Stone Dragon Media</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="/universal.css" />
    <style is:global>
      /* Shared portal rules live in public/universal.css; these are admin-only. */
      .portal-nav a,
      .portal-viewsite a {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .portal-nav .icon,
      .portal-viewsite .icon {
        width: 1.05rem;
        height: 1.05rem;
        flex-shrink: 0;
      }

      .portal-logout button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }

      .portal-logout .icon {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
      }

      .header-actions {
        display: flex;
        gap: 0.6rem;
      }

      .card-danger {
        border-color: rgba(173, 38, 38, 0.4);
        background: rgba(173, 38, 38, 0.04);
      }

      .danger-label {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin: 0 0 0.6rem;
        font-family: "Sora", sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #7d2121;
      }

      .danger-label .icon {
        width: 0.95rem;
        height: 0.95rem;
      }

      .badge-internal {
        background: linear-gradient(125deg, #1f5a89, #2f709f);
        color: #edf6ff;
      }

      .filter-select {
        width: 100%;
        border: 1px solid rgba(108, 153, 188, 0.38);
        background: rgba(255, 255, 255, 0.95);
        border-radius: 0.62rem;
        padding: 0.6rem 0.7rem;
        font: inherit;
        color: var(--ink);
      }

      .btn .icon {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
      }

      .btn-danger {
        background: rgba(173, 38, 38, 0.1);
        border-color: rgba(173, 38, 38, 0.32);
        color: #7d2121;
      }

      .project-columns {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 1.2rem;
        align-items: stretch;
      }

      @media (max-width: 900px) {
        .project-columns {
          grid-template-columns: 1fr;
        }
      }

      .kanban-card {
        cursor: grab;
      }

      .kanban-card-link {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        color: inherit;
        text-decoration: none;
        cursor: inherit;
      }

      .kanban-lane-select {
        margin-top: 0.2rem;
        padding: 0.25rem 0.4rem;
        font-size: 0.78rem;
        border: 1px solid var(--line);
        border-radius: 0.45rem;
        background: var(--surface);
        color: var(--ink);
      }

      .kanban-card.dragging {
        opacity: 0.5;
      }

      .modal {
        border: 1px solid var(--line);
        border-radius: 0.95rem;
        padding: 0;
        width: min(560px, calc(100vw - 2.4rem));
        max-height: min(680px, calc(100vh - 2.4rem));
        color: var(--ink);
        background: var(--surface-strong);
      }

      .modal::backdrop {
        background: rgba(16, 38, 59, 0.45);
      }

      .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.1rem 0.9rem;
        border-bottom: 1px solid var(--line);
      }

      .modal-header h2 {
        margin: 0;
        font-family: "Sora", sans-serif;
        font-size: 1rem;
        color: var(--brand-strong);
      }

      .modal-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        border-radius: 0.5rem;
        cursor: pointer;
      }

      .modal-close:hover {
        background: rgba(90, 128, 156, 0.16);
      }

      .modal-body {
        padding: 1.1rem;
        overflow-y: auto;
      }

      .modal-footer {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1.1rem;
        border-top: 1px solid var(--line);
      }

      .modal-section-heading {
        margin: 0 0 0.8rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--line);
        font-family: "Sora", sans-serif;
        font-size: 0.95rem;
        color: var(--brand-strong);
      }
    </style>
    <slot name="head" />
  </head>
  <body class="portal">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="portal-shell">
      <aside class="portal-sidebar">
        <a class="portal-brand" href="/admin">
          <img src="/dashboard-logo.png" alt="Stone Dragon Media" width="800" height="307" />
        </a>
        <nav class="portal-nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : !item.exact && isActive(item.href) ? "location" : undefined}
              class={(item.exact ? currentPath === item.href : isActive(item.href)) ? "active" : undefined}
            >
              <Icon class="icon" name={item.icon} aria-hidden="true" />
              {item.label}
            </a>
          ))}
        </nav>
        <div class="portal-viewsite">
          <a href="/" target="_blank" rel="noopener">
            <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
            View Public Site
          </a>
        </div>
        <div class="portal-logout">
          <form method="post" action="/api/auth/logout">
            <button type="submit">
              <Icon class="icon" name="lucide:log-out" aria-hidden="true" />
              Log Out
            </button>
          </form>
        </div>
      </aside>
      <main class="portal-main" id="main-content" tabindex="-1">
        <div class="portal-header">
          <h1>{title}</h1>
        </div>
        <slot />
      </main>
    </div>
    <div id="portal-announcer" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import { announcePageNotices } from "../lib/announce";
      announcePageNotices();
    </script>
  </body>
</html>
