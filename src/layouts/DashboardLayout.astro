---
interface Props {
  title: string;
}

const { title } = Astro.props;
const { user, impersonatedClient } = Astro.locals;

const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, "");
const isActive = (prefix: string) => currentPath === prefix || currentPath.startsWith(`${prefix}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Stone Dragon Media</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Sora:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="/universal.css" />
    <style is:global>
      /* Shared portal rules live in public/universal.css; these are dashboard-only. */
      .impersonation-banner {
        background: #7d5a12;
        color: #fff5e0;
        padding: 0.6rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .impersonation-banner button {
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.32);
        color: inherit;
        border-radius: 0.5rem;
        padding: 0.3rem 0.7rem;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }

      .btn[disabled] {
        opacity: 0.55;
        cursor: not-allowed;
      }
    </style>
    <slot name="head" />
  </head>
  <body class="portal">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {impersonatedClient && (
      <div class="impersonation-banner">
        <span>Viewing as {impersonatedClient.companyName}</span>
        <form method="post" action="/api/admin/impersonate/stop">
          <button type="submit">Exit</button>
        </form>
      </div>
    )}
    <div class="portal-shell">
      <aside class="portal-sidebar">
        <a class="portal-brand" href="/dashboard">
          <img src="/dashboard-logo.png" alt="Stone Dragon Media" width="800" height="307" />
        </a>
        <nav class="portal-nav">
          <a href="/dashboard" aria-current={currentPath === "/dashboard" ? "page" : undefined} class={isActive("/dashboard") && currentPath === "/dashboard" ? "active" : undefined}>Overview</a>
          <a href="/dashboard/projects" aria-current={currentPath === "/dashboard/projects" ? "page" : isActive("/dashboard/projects") ? "location" : undefined} class={isActive("/dashboard/projects") ? "active" : undefined}>Projects</a>
          <a href="/dashboard/billing" aria-current={currentPath === "/dashboard/billing" ? "page" : isActive("/dashboard/billing") ? "location" : undefined} class={isActive("/dashboard/billing") ? "active" : undefined}>Billing</a>
          <a href="/dashboard/tickets" aria-current={currentPath === "/dashboard/tickets" ? "page" : isActive("/dashboard/tickets") ? "location" : undefined} class={isActive("/dashboard/tickets") ? "active" : undefined}>Tickets</a>
          {!impersonatedClient && (
            <a href="/dashboard/settings" aria-current={currentPath === "/dashboard/settings" ? "page" : isActive("/dashboard/settings") ? "location" : undefined} class={isActive("/dashboard/settings") ? "active" : undefined}>Settings</a>
          )}
        </nav>
        <div class="portal-viewsite">
          <a href="/" target="_blank" rel="noopener">View Public Site &#8599;</a>
        </div>
        {!impersonatedClient && user && (
          <div class="portal-logout">
            <form method="post" action="/api/auth/logout">
              <button type="submit">Log Out</button>
            </form>
          </div>
        )}
      </aside>
      <main class="portal-main" id="main-content" tabindex="-1">
        <div class="portal-header">
          <h1>{title}</h1>
        </div>
        <slot />
      </main>
    </div>
    <div id="portal-announcer" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import { announcePageNotices } from "../lib/announce";
      announcePageNotices();
    </script>
  </body>
</html>
